# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# AI providers (server-side only, never exposed to the browser). At least one key enables AI features.
# Google Gemini — aistudio.google.com → Get API key. Default engine for most tasks.
GEMINI_API_KEY=
# Anthropic Claude — console.anthropic.com → API Keys. Used for premium tasks (SEO article drafts) and as a fallback.
ANTHROPIC_API_KEY=

# AI routing (optional). Each task has a tier: light (classification, short edits), standard, premium (long-form).
# Built-in defaults: light gemini-3.1-flash-lite · standard gemini-3.8-flash · premium claude-sonnet-5-5.
# Values: "provider:model", a model id, or just a provider (uses that provider's model for the tier).
# AI_DEFAULT_PROVIDER=gemini
# AI_DEFAULT_MODEL=gemini-3.8-flash          # one model for every task (AI_TIER_* and AI_ROUTE_* still take precedence)
# AI_TIER_LIGHT=gemini:gemini-3.1-flash-lite
# AI_TIER_STANDARD=gemini:gemini-3.8-flash
# AI_TIER_PREMIUM=anthropic:claude-sonnet-5-5
# AI_ROUTE_SERP_DRAFT=anthropic:claude-opus-5-5   # per task (feature name in caps, dots → _)
# AI_ROUTE_PRODUCTION=gemini                      # per module
# Stop AI requests for a workspace once its estimated spend this month reaches this amount (USD).
# AI_MONTHLY_BUDGET_USD=50

# Meta (Facebook Pages + Instagram) — see docs/META_SETUP.md. Server-side only.
META_APP_ID=
META_APP_SECRET=
META_TOKEN_ENCRYPTION_KEY=
APP_URL=http://localhost:3000
# META_REDIRECT_URI=http://localhost:3000/api/meta/callback
# META_LOGIN_CONFIG_ID=
# META_GRAPH_VERSION=v26.0

# Scheduled Meta sync, competitor monitoring and Meta callbacks (optional; server-side only)
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=

# Competitor Intelligence data sources (optional; server-side only). Instagram uses the Meta connection above.
# YouTube Data API v3 key: Google Cloud console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key
# YOUTUBE_API_KEY=
# X API v2 bearer token (paid Basic plan or higher; the free plan can't read other accounts)
# X_BEARER_TOKEN=

# SERP Intelligence (server-side only): serpapi.com → Dashboard → Your Private API Key (free plan: 100 searches/month)
# SERPAPI_API_KEY=
